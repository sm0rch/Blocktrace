# Backend storage type: file, postgres, mysql, mongodb
DB_TYPE=file

# PostgreSQL / MySQL connection string examples
# DATABASE_URL=postgresql://user:password@localhost:5432/blocktrace
# DATABASE_URL=mysql://user:password@localhost:3306/blocktrace
# DB_SSL=true
# DB_CONNECTION_LIMIT=10

# MongoDB connection string example
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=blocktrace

# Blockchain provider and contract settings
BLOCKCHAIN_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_PRIVATE_KEY=your_sepolia_private_key_without_quotes
SMART_CONTRACT_ADDRESS=0xYourSepoliaContractAddress
SMART_CONTRACT_ABI_PATH=hardhat/artifacts/contracts/Counter.sol/Counter.json

